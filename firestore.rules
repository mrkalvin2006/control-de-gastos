rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      // Returns the role of the requesting user, or null if it doesn't exist
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role 
        : null;
    }
    
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || getUserRole() == 'presidente');
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId;
    }

    match /transactions/{transactionId} {
      // President can read all. Regular users can read only their own.
      allow read: if isAuthenticated() && (getUserRole() == 'presidente' || request.auth.uid == resource.data.userId);
      
      // Users can create/update/delete their own transactions
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }
  }
}
