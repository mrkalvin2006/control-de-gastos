{
  "projectInfo": {
    "name": "Libro de Caja Roles"
  },
  "auth": {
    "providers": ["email"]
  },
  "collections": [
    {
      "name": "users",
      "documentId": "{userId}",
      "schema": {
        "role": "string (caja_chica, caja_central, asistenta_social, prensa, presidente)",
        "email": "string",
        "name": "string"
      },
      "rules": {
        "read": "Owner or Presidente",
        "create": "Owner",
        "update": "Owner"
      }
    },
    {
      "name": "transactions",
      "documentId": "{transactionId}",
      "schema": {
        "type": "string (ingreso, egreso)",
        "date": "string",
        "quantity": "number",
        "description": "string",
        "amount": "number",
        "userId": "string (reference to users/{userId})",
        "userRole": "string",
        "createdAt": "timestamp"
      },
      "rules": {
        "read": "Owner or Presidente",
        "create": "Owner",
        "update": "Owner",
        "delete": "Owner"
      }
    }
  ]
}
